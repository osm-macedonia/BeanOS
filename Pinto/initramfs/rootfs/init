#!/bin/sh

export PATH=/bin:/sbin:/usr/bin:/usr/sbin

echo "========================================"
echo "          Welcome to PintoOS"
echo "             First Seed Release"
echo "          Tiny Linux Initramfs"
echo "========================================"
echo ""

echo "Preparing system..."

mkdir -p /proc /sys /dev /tmp /root /run /var

mount -t proc proc /proc 2>/dev/null || echo "Warning: proc mount failed"
mount -t sysfs sysfs /sys 2>/dev/null || echo "Warning: sysfs mount failed"
mount -t devtmpfs devtmpfs /dev 2>/dev/null || echo "Warning: devtmpfs mount failed"

mkdir -p /dev/pts 2>/dev/null

[ -e /dev/console ] || mknod /dev/console c 5 1 2>/dev/null
[ -e /dev/null ] || mknod /dev/null c 1 3 2>/dev/null
[ -e /dev/zero ] || mknod /dev/zero c 1 5 2>/dev/null
[ -e /dev/tty ] || mknod /dev/tty c 5 0 2>/dev/null

echo ""
echo "PintoOS hardware layer ready."
echo ""

echo "Toybox is available:"
/bin/toybox

echo ""
echo "Launching Pinto shell..."
echo ""

exec /bin/sh
